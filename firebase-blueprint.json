{
  "entities": {
    "places": {
      "title": "Places",
      "description": "Monitored geospatial places dataset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "place_name": { "type": "string" },
        "area": { "type": "string" },
        "street": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["id", "place_name", "latitude", "longitude"]
    },
    "snapshots": {
      "title": "Snapshots",
      "description": "Historical map snapshots for places",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placeId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "number" },
        "dateLabel": { "type": "string" },
        "notes": { "type": "string" },
        "zoomLevel": { "type": "number" },
        "mapType": { "type": "string" }
      },
      "required": ["id", "placeId", "imageUrl", "timestamp", "dateLabel"]
    },
    "accidents": {
      "title": "Accidents",
      "description": "City accident events (car accident, nature event, tree cutting, building construction, damage, weather, animal dies)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "placeId": { "type": "string" },
        "placeName": { "type": "string" },
        "cityName": { "type": "string" },
        "accidentType": { "type": "string" },
        "severity": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "placeId", "accidentType", "severity", "timestamp"]
    },
    "alarms": {
      "title": "Alarms",
      "description": "Accident and incident alarms configured for cities and places",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accidentType": { "type": "string" },
        "severityThreshold": { "type": "string" },
        "isMuted": { "type": "boolean" },
        "audioAlertEnabled": { "type": "boolean" },
        "createdDate": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["id", "accidentType", "severityThreshold"]
    }
  }
}
